# =========================================================================
# MedIA Practice SaaS — Configurações de Ambiente (.env.example)
# =========================================================================

# Porta do Servidor Web
PORT=8000

# Chave secreta de assinatura JWT (Gere uma chave forte em produção com `openssl rand -hex 32`)
SECRET_KEY=sua-chave-secreta-jwt-super-segura-de-32-caracteres

# Banco de Dados
# Para desenvolvimento local rápido: sqlite:///./esus.db
# Para produção com PostgreSQL no Docker: postgresql://media_user:media_pass@localhost:5432/media_db
DATABASE_URL=sqlite:///./esus.db
POSTGRES_PASSWORD=media_pass

# Inteligência Artificial / Copiloto Clínico (Google Gemini)
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=

# Servidor TURN / WebRTC para Telemedicina
TURN_SECRET=media-turn-secret-trocar-em-producao

# Ambiente
ENVIRONMENT=development
LOG_LEVEL=info
