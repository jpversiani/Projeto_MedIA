# =========================================================================
# MedIA Practice SaaS — Configurações de Ambiente (.env.example)
#
# Copie para `.env` na raiz do repositório:  cp .env.example .env
# A aplicação lê este arquivo automaticamente (pydantic-settings).
# =========================================================================

# -------------------------------------------------------------------------
# Ambiente
# -------------------------------------------------------------------------
# development | test | staging | production
# Em `staging`/`production` a aplicação RECUSA SUBIR se a chave JWT estiver
# ausente ou se as flags de demonstração estiverem ligadas.
ENVIRONMENT=development
LOG_LEVEL=info

# Porta do servidor (quando iniciado pelo docker-compose)
PORT=8000

# -------------------------------------------------------------------------
# Segurança
# -------------------------------------------------------------------------
# OBRIGATÓRIA em staging/production. Gere com:  openssl rand -hex 32
# Sem isso, em produção, a aplicação não sobe.
# O nome legado `SECRET_KEY` também é aceito (mantido por compatibilidade).
JWT_SECRET_KEY=

# Origens permitidas no CORS, separadas por vírgula.
# Nunca use "*" com dados de saúde: permitiria leitura de prontuário por
# qualquer site que o médico acesse.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# -------------------------------------------------------------------------
# Comportamento
# -------------------------------------------------------------------------
# Exigir `Authorization: Bearer <token>` em todas as rotas clínicas.
# Ligado automaticamente fora de desenvolvimento.
REQUIRE_AUTH=false

# Aplicar `alembic upgrade head` no startup.
AUTO_MIGRATE_ON_STARTUP=true

# Popular o banco no primeiro boot (2 unidades, profissionais, terminologias).
# SEMPRE false em produção — popularia prontuários fictícios na base real.
AUTO_SEED_DEMO_DATA=true

# Login instantâneo via `{"demo_role": "medico_titular"}`, sem senha.
# SEMPRE false em produção — permitiria obter token de administrador.
DEMO_LOGIN_ENABLED=true

# SSO Google/Microsoft. ATENÇÃO: hoje é um MOCK que não valida o `id_token`
# e é recusado em produção. Habilite apenas para explorar a interface.
SSO_ENABLED=true

# -------------------------------------------------------------------------
# Banco de Dados
# -------------------------------------------------------------------------
# Omitir resolve para backend/esus.db, independente do diretório de onde o
# servidor foi iniciado.
#   SQLite:     sqlite:///./esus.db
#   PostgreSQL: postgresql+psycopg2://media_user:SENHA@localhost:5432/media_db
DATABASE_URL=

POSTGRES_PASSWORD=troque-esta-senha

# -------------------------------------------------------------------------
# Integrações
# -------------------------------------------------------------------------
# Copiloto clínico (Google Gemini) — https://aistudio.google.com/
GEMINI_API_KEY=

# Servidor TURN para telemedicina. Gere: openssl rand -hex 32
TURN_SECRET=

# Credenciais OAuth. Sem elas o SSO usa identificadores de demonstração.
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
